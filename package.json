{
  "name": "refine-cv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CV tailoring workflow with GitHub evidence indexing",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "extract-cv": "pnpm build && node dist/bin/extract-cv.js",
    "index-github": "pnpm build && node dist/bin/index-github.js",
    "list-repos": "pnpm build && node dist/bin/list-repos.js",
    "validate": "pnpm build && node dist/bin/validate-setup.js",
    "render-cv": "pnpm build && node dist/bin/render-cv.js",
    "scan-jobs": "pnpm build && node dist/bin/scan-jobs.js",
    "mark-applied": "pnpm build && node dist/bin/mark-applied.js",
    "linkedin:login": "pnpm build && node dist/bin/linkedin-login.js",
    "discover-linkedin": "pnpm build && node dist/bin/discover-linkedin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-toptal-guides": "pnpm build && node dist/bin/extract-toptal-guides.js",
    "setup:pdf": "pnpm exec puppeteer browsers install chrome",
    "setup:linkedin": "pnpm exec playwright install chrome",
    "auth:github": "gh auth login",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "check:release": "node --experimental-strip-types scripts/check-release-safety.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "commander": "^14.0.3",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.52.0",
    "puppeteer": "^24.36.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pdf-parse": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["puppeteer", "playwright"]
  }
}
